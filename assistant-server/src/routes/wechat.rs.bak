use axum::{extract::{Query, State}, response::Html, routing::{delete, get, post}, Json, Router};
use chrono::{Duration, Utc};
use serde::{Deserialize, Serialize};
use serde_json::Value;
use uuid::Uuid;

use crate::{
    app_state::{AppState, RuntimeWechatSession},
    auth::CurrentUser,
    error::ApiError,
    services::wechat::WeChatService,
};

#[derive(Debug, Deserialize)]
struct WechatAuthQuery {
    code: String,
    state: String,
}

#[derive(Debug, Serialize)]
struct WechatAuthUrlResponse {
    auth_url: String,
}

#[derive(Debug, Serialize)]
struct BindingStatusResponse {
    bound: bool,
    openid: Option<String>,
    nickname: Option<String>,
    avatar_url: Option<String>,
}

#[derive(Debug, Deserialize)]
struct BindWechatRequest {
    code: String,
    state: String,
}

#[derive(Debug, Serialize)]
struct GenericOk {
    success: bool,
}

#[derive(Debug, Serialize)]
struct ChannelLoginStartResponse {
    session_id: Uuid,
    qrcode: String,
    qrcode_link: String,
}

#[derive(Debug, Deserialize)]
struct ChannelLoginConfirmRequest {
    session_id: Uuid,
}

#[derive(Debug, Serialize)]
struct ChannelLoginConfirmResponse {
    connected: bool,
    status: String,
}

#[derive(Debug, Deserialize)]
struct SendTextRequest {
    text: String,
    context_token: Option<String>,
}

#[derive(Debug, Deserialize)]
struct ListenerStartRequest {
    verification_text: String,
}

pub fn routes() -> Router<AppState> {
    Router::new()
        .route("/api/wechat/auth-url", get(get_auth_url))
        .route("/api/wechat/callback", get(callback))
        .route("/api/wechat/bind", post(bind_wechat))
        .route("/api/wechat/unbind", delete(unbind_wechat))
        .route("/api/wechat/binding-status", get(get_binding_status))
        .route("/api/wechat/channel/login/start", post(channel_login_start))
        .route("/api/wechat/channel/login/confirm", post(channel_login_confirm))
        .route("/api/wechat/channel/listener/start", post(channel_listener_start))
        .route("/api/wechat/channel/send", post(channel_send))
}

async fn get_auth_url(
    State(state): State<AppState>,
    user: CurrentUser,
) -> Result<Json<WechatAuthUrlResponse>, ApiError> {
    let csrf_state = Uuid::new_v4().to_string();
    let expires_at = Utc::now() + Duration::minutes(5);
    sqlx::query(
        "INSERT INTO wechat_oauth_states (state, user_id, expires_at, created_at) VALUES ($1, $2, $3, NOW())",
    )
    .bind(&csrf_state)
    .bind(user.id)
    .bind(expires_at)
    .execute(&state.db)
    .await?;

    let auth_url = state.wechat_service.generate_auth_url(&csrf_state);
    Ok(Json(WechatAuthUrlResponse { auth_url }))
}

async fn callback(
    State(state): State<AppState>,
    Query(query): Query<WechatAuthQuery>,
) -> Result<Html<&'static str>, ApiError> {
    let rec: Option<(Uuid,)> = sqlx::query_as(
        "SELECT user_id FROM wechat_oauth_states WHERE state = $1 AND expires_at > NOW()",
    )
    .bind(&query.state)
    .fetch_optional(&state.db)
    .await?;
    let Some((user_id,)) = rec else {
        return Err(ApiError::BadRequest("无效或过期的 state".to_string()));
    };

    sqlx::query("DELETE FROM wechat_oauth_states WHERE state = $1")
        .bind(&query.state)
        .execute(&state.db)
        .await?;

    let (access_token, openid) = state.wechat_service.get_access_token(&query.code).await?;
    let user_info = state.wechat_service.get_user_info(&access_token, &openid).await?;
    state
        .wechat_service
        .bind_wechat_to_user(&state.db, user_id, &user_info)
        .await?;

    Ok(Html(include_str!("../../templates/wechat_success.html")))
}

async fn bind_wechat(
    State(state): State<AppState>,
    user: CurrentUser,
    Json(req): Json<BindWechatRequest>,
) -> Result<Json<GenericOk>, ApiError> {
    let rec: Option<(Uuid,)> = sqlx::query_as(
        "SELECT user_id FROM wechat_oauth_states WHERE state = $1 AND expires_at > NOW()",
    )
    .bind(&req.state)
    .fetch_optional(&state.db)
    .await?;
    let Some((state_user_id,)) = rec else {
        return Err(ApiError::BadRequest("无效或过期的 state".to_string()));
    };
    if state_user_id != user.id {
        return Err(ApiError::Forbidden);
    }

    let (access_token, openid) = state.wechat_service.get_access_token(&req.code).await?;
    let user_info = state.wechat_service.get_user_info(&access_token, &openid).await?;
    state
        .wechat_service
        .bind_wechat_to_user(&state.db, user.id, &user_info)
        .await?;

    sqlx::query("DELETE FROM wechat_oauth_states WHERE state = $1")
        .bind(&req.state)
        .execute(&state.db)
        .await?;

    Ok(Json(GenericOk { success: true }))
}

async fn unbind_wechat(
    State(state): State<AppState>,
    user: CurrentUser,
) -> Result<Json<GenericOk>, ApiError> {
    sqlx::query("DELETE FROM user_wechat_bindings WHERE user_id = $1")
        .bind(user.id)
        .execute(&state.db)
        .await?;

    Ok(Json(GenericOk { success: true }))
}

async fn get_binding_status(
    State(state): State<AppState>,
    user: CurrentUser,
) -> Result<Json<BindingStatusResponse>, ApiError> {
    let binding: Option<(String, Option<String>, Option<String>)> = sqlx::query_as(
        "SELECT openid, nickname, avatar_url FROM user_wechat_bindings WHERE user_id = $1 ORDER BY updated_at DESC LIMIT 1",
    )
    .bind(user.id)
    .fetch_optional(&state.db)
    .await?;

    if let Some((openid, nickname, avatar_url)) = binding {
        Ok(Json(BindingStatusResponse {
            bound: true,
            openid: Some(openid),
            nickname,
            avatar_url,
        }))
    } else {
        Ok(Json(BindingStatusResponse {
            bound: false,
            openid: None,
            nickname: None,
            avatar_url: None,
        }))
    }
}

async fn channel_login_start(
    State(state): State<AppState>,
    user: CurrentUser,
) -> Result<Json<ChannelLoginStartResponse>, ApiError> {
    let payload: Value = state
        .wechat_service
        .get_bot_qrcode(&state.settings.wechat.qr_bot_type)
        .await?;

    let qrcode = payload
        .get("qrcode")
        .and_then(Value::as_str)
        .unwrap_or_default()
        .to_string();
    let qrcode_link = payload
        .get("qrcode_img_content")
        .and_then(Value::as_str)
        .unwrap_or_default()
        .to_string();

    if qrcode.is_empty() || qrcode_link.is_empty() {
        return Err(ApiError::BadRequest(format!("获取二维码失败: {payload}")));
    }

    let session_id = Uuid::new_v4();
    let session = RuntimeWechatSession {
        user_id: user.id,
        qrcode,
        qrcode_link,
        created_at: Utc::now(),
    };

    state.in_memory_sessions.write().await.insert(session_id, session.clone());

    Ok(Json(ChannelLoginStartResponse {
        session_id,
        qrcode: session.qrcode,
        qrcode_link: session.qrcode_link,
    }))
}

async fn channel_login_confirm(
    State(state): State<AppState>,
    user: CurrentUser,
    Json(req): Json<ChannelLoginConfirmRequest>,
) -> Result<Json<ChannelLoginConfirmResponse>, ApiError> {
    let session = state
        .in_memory_sessions
        .read()
        .await
        .get(&req.session_id)
        .cloned()
        .ok_or_else(|| ApiError::BadRequest("无效会话".to_string()))?;

    if session.user_id != user.id {
        return Err(ApiError::Forbidden);
    }

    let status_payload = state.wechat_service.get_qrcode_status(&session.qrcode).await?;
    let status = status_payload
        .get("status")
        .and_then(Value::as_str)
        .unwrap_or("wait")
        .to_string();

    if status == "confirmed" {
        let bot_token = status_payload
            .get("bot_token")
            .and_then(Value::as_str)
            .unwrap_or_default()
            .to_string();
        let login_user_id = status_payload
            .get("ilink_user_id")
            .and_then(Value::as_str)
            .map(ToString::to_string);
        let account_id = status_payload
            .get("ilink_bot_id")
            .and_then(Value::as_str)
            .map(ToString::to_string);

        if bot_token.is_empty() {
            return Err(ApiError::BadRequest("登录确认成功但 bot_token 为空".to_string()));
        }

        sqlx::query(
            r#"
            INSERT INTO user_wechat_channels (user_id, bot_token, account_id, login_user_id, listener_started, token_expiry_reminder_sent, updated_at)
            VALUES ($1, $2, $3, $4, false, false, NOW())
            ON CONFLICT (user_id) DO UPDATE
            SET bot_token = EXCLUDED.bot_token,
                account_id = EXCLUDED.account_id,
                login_user_id = EXCLUDED.login_user_id,
                updated_at = NOW()
            "#,
        )
        .bind(user.id)
        .bind(bot_token)
        .bind(account_id)
        .bind(login_user_id)
        .execute(&state.db)
        .await?;

        state.in_memory_sessions.write().await.remove(&req.session_id);
    }

    Ok(Json(ChannelLoginConfirmResponse {
        connected: status == "confirmed",
        status,
    }))
}

async fn channel_listener_start(
    State(state): State<AppState>,
    user: CurrentUser,
    Json(req): Json<ListenerStartRequest>,
) -> Result<Json<GenericOk>, ApiError> {
    if req.verification_text.trim().is_empty() {
        return Err(ApiError::BadRequest("verification_text 不能为空".to_string()));
    }

    let updated = sqlx::query(
        "UPDATE user_wechat_channels SET listener_started = true, listener_verify_text = $1, listener_verify_status = 'pending', updated_at = NOW() WHERE user_id = $2",
    )
    .bind(req.verification_text.trim())
    .bind(user.id)
    .execute(&state.db)
    .await?;

    if updated.rows_affected() == 0 {
        return Err(ApiError::BadRequest("请先完成微信通道登录".to_string()));
    }

    Ok(Json(GenericOk { success: true }))
}

async fn channel_send(
    State(state): State<AppState>,
    user: CurrentUser,
    Json(req): Json<SendTextRequest>,
) -> Result<Json<GenericOk>, ApiError> {
    if req.text.trim().is_empty() {
        return Err(ApiError::BadRequest("text 不能为空".to_string()));
    }

    let row: Option<(String, Option<String>, Option<String>)> = sqlx::query_as(
        "SELECT bot_token, active_user_id, login_user_id FROM user_wechat_channels WHERE user_id = $1",
    )
    .bind(user.id)
    .fetch_optional(&state.db)
    .await?;
    let Some((bot_token, active_user_id, login_user_id)) = row else {
        return Err(ApiError::BadRequest("请先完成微信通道登录".to_string()));
    };

    let target = active_user_id.or(login_user_id).unwrap_or_default();
    if target.trim().is_empty() {
        return Err(ApiError::BadRequest("未找到可发送目标用户".to_string()));
    }

    let normalized = WeChatService::normalize_weixin_user_id(&target);
    let context_token = req.context_token.unwrap_or_default();
    let resp = state
        .wechat_service
        .send_text_message(&bot_token, &normalized, req.text.trim(), &context_token)
        .await?;

    if resp.ret != 0 {
        return Err(ApiError::BadRequest(format!(
            "发送失败: errcode={:?}, errmsg={:?}",
            resp.errcode, resp.errmsg
        )));
    }

    Ok(Json(GenericOk { success: true }))
}

use axum::{extract::State, routing::{get, put}, Json, Router};
use serde::{Deserialize, Serialize};
use serde_json::Value;

use crate::{
    app_state::AppState,
    auth::CurrentUser,
    error::ApiError,
    models::user::UserConfig,
};

#[derive(Debug, Serialize)]
struct UserSettingsResponse {
    default_model: String,
    theme: String,
    openai_api_key: Option<String>,
    anthropic_api_key: Option<String>,
    settings: Value,
}

#[derive(Debug, Deserialize)]
struct UpdateUserSettingsRequest {
    default_model: Option<String>,
    theme: Option<String>,
    openai_api_key: Option<String>,
    anthropic_api_key: Option<String>,
    settings: Option<Value>,
}

pub fn routes() -> Router<AppState> {
    Router::new()
        .route("/api/settings/profile", get(get_user_settings))
        .route("/api/settings/profile", put(update_user_settings))
}

async fn get_user_settings(
    State(state): State<AppState>,
    user: CurrentUser,
) -> Result<Json<UserSettingsResponse>, ApiError> {
    let config = sqlx::query_as::<_, UserConfig>(
        "SELECT user_id, openai_api_key, anthropic_api_key, default_model, theme, settings FROM user_configs WHERE user_id = $1",
    )
    .bind(user.id)
    .fetch_optional(&state.db)
    .await?;

    if let Some(cfg) = config {
        Ok(Json(UserSettingsResponse {
            default_model: cfg.default_model,
            theme: cfg.theme,
            openai_api_key: cfg.openai_api_key,
            anthropic_api_key: cfg.anthropic_api_key,
            settings: cfg.settings,
        }))
    } else {
        Ok(Json(UserSettingsResponse {
            default_model: "gpt-4o-mini".to_string(),
            theme: "light".to_string(),
            openai_api_key: None,
            anthropic_api_key: None,
            settings: serde_json::json!({}),
        }))
    }
}

async fn update_user_settings(
    State(state): State<AppState>,
    user: CurrentUser,
    Json(req): Json<UpdateUserSettingsRequest>,
) -> Result<Json<UserSettingsResponse>, ApiError> {
    let default_model = req
        .default_model
        .unwrap_or_else(|| "gpt-4o-mini".to_string())
        .trim()
        .to_string();
    let theme = req
        .theme
        .unwrap_or_else(|| "light".to_string())
        .trim()
        .to_string();
    let settings_json = req.settings.unwrap_or_else(|| serde_json::json!({}));

    let rec = sqlx::query_as::<_, UserConfig>(
        r#"
        INSERT INTO user_configs (user_id, openai_api_key, anthropic_api_key, default_model, theme, settings)
        VALUES ($1, $2, $3, $4, $5, $6)
        ON CONFLICT (user_id) DO UPDATE
        SET openai_api_key = EXCLUDED.openai_api_key,
            anthropic_api_key = EXCLUDED.anthropic_api_key,
            default_model = EXCLUDED.default_model,
            theme = EXCLUDED.theme,
            settings = EXCLUDED.settings
        RETURNING user_id, openai_api_key, anthropic_api_key, default_model, theme, settings
        "#,
    )
    .bind(user.id)
    .bind(req.openai_api_key)
    .bind(req.anthropic_api_key)
    .bind(default_model)
    .bind(theme)
    .bind(settings_json)
    .fetch_one(&state.db)
    .await?;

    Ok(Json(UserSettingsResponse {
        default_model: rec.default_model,
        theme: rec.theme,
        openai_api_key: rec.openai_api_key,
        anthropic_api_key: rec.anthropic_api_key,
        settings: rec.settings,
    }))
}
